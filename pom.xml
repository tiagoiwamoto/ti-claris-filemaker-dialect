<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.tiagoiwamoto</groupId>
    <artifactId>claris-filemaker</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Claris FileMaker Hibernate Dialect</name>
    <description>Dialect and function contributor to integrate Claris FileMaker with Hibernate (packaged as a reusable dependency).</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Dependência para o driver fmjdbc.jar (arquivo local).
             Usamos scope=system+systemPath para que o analisador estático do IDE não reporte artefato faltando.
             Também mantemos o maven-install-plugin abaixo para instalar esse mesmo JAR no repositório local durante a build,
             permitindo que outros projetos o consumam como uma dependência normal. -->
        <dependency>
            <groupId>io.github.tiagoiwamoto</groupId>
            <artifactId>fmjdbc</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/src/main/resources/fmjdbc.jar</systemPath>
        </dependency>

        <!-- Hibernate Core 7.1 -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>7.1.4.Final</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Garante que o fmjdbc.jar local (em src/main/resources) seja instalado
                 no repositório local antes da compilação, permitindo que o artefato
                 final seja publicado e consumido por outros projetos. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>2.5.2</version>
                <executions>
                    <execution>
                        <id>install-external-fmjdbc</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${project.basedir}/src/main/resources/fmjdbc.jar</file>
                            <groupId>io.github.tiagoiwamoto</groupId>
                            <artifactId>fmjdbc</artifactId>
                            <version>1.0.0</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Plugin de compilação padrão -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>